<UserControl x:Class="GtaRpAssistant.App.Features.KnowledgeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:design="clr-namespace:GtaRpAssistant.App.DesignSystem.Controls"
             AutomationProperties.AutomationId="Page.Knowledge">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch" Margin="0,0,14,20">
            <design:FeaturePageHeader Style="{StaticResource Feature.PageHeader}"
                                      Title="База знаний"
                                      Description="Проверенные официальные статьи и отдельно маркированные сведения игроков — локально и без обязательной модели." />

            <UniformGrid Columns="3" Margin="0,0,0,12">
                <design:MetricCard Style="{StaticResource Feature.MetricCard}" Margin="0,0,6,0"
                                   Label="ВСЕГО СТАТЕЙ" Value="{Binding TotalArticleCount}"
                                   AccentBrush="{DynamicResource Brush.Accent}"
                                   AutomationProperties.AutomationId="Knowledge.Total" />
                <design:MetricCard Style="{StaticResource Feature.MetricCard}" Margin="6,0"
                                   Label="ОФИЦИАЛЬНЫЕ" Value="{Binding OfficialArticleCount}"
                                   AccentBrush="{DynamicResource Brush.Success}"
                                   AutomationProperties.AutomationId="Knowledge.Official" />
                <design:MetricCard Style="{StaticResource Feature.MetricCard}" Margin="6,0,0,0"
                                   Label="ДАННЫЕ ИГРОКОВ" Value="{Binding CommunityArticleCount}"
                                   AccentBrush="{DynamicResource Brush.Warning}"
                                   AutomationProperties.AutomationId="Knowledge.Community" />
            </UniformGrid>

            <design:FeatureSection Style="{StaticResource Feature.Section}" Margin="0,0,0,12"
                                   Title="Документы и источники"
                                   Description="Поиск по названию, источнику и фактам. Выберите документ, чтобы увидеть его фрагменты и дату актуальности.">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Название, источник или факт" AutomationProperties.AutomationId="Knowledge.Search" />
                        <ComboBox Grid.Column="1" Margin="8,0" ItemsSource="{Binding TrustFilters}" SelectedItem="{Binding TrustFilter}" AutomationProperties.AutomationId="Knowledge.TrustFilter" />
                        <Button Grid.Column="2" Content="Импорт файла…" Command="{Binding ImportCommand}" AutomationProperties.AutomationId="Knowledge.Import" />
                    </Grid>
                    <ListBox Height="210" ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}" AutomationProperties.AutomationId="Knowledge.Documents">
                        <ListBox.ItemTemplate><DataTemplate><Grid Margin="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Style="{StaticResource Text.Secondary}"><Run Text="{Binding Trust}" /><Run Text=" · " /><Run Text="{Binding Source}" /><Run Text=" · " /><Run Text="{Binding Server}" /><Run Text=" · " /><Run Text="{Binding FactLabel, Mode=OneWay}" /></TextBlock></StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding UpdatedLabel, Mode=OneWay}" Style="{StaticResource Text.Secondary}" />
                        </Grid></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Border Style="{StaticResource Surface.RaisedCard}" Margin="0,10,0,0" DataContext="{Binding SelectedDocument}">
                        <StackPanel><TextBlock Style="{StaticResource Text.Label}" Text="ПРЕДПРОСМОТР ФАКТОВ И ФРАГМЕНТОВ" /><TextBlock Margin="0,6,0,0" Text="{Binding Preview}" TextWrapping="Wrap" MaxHeight="120" /></StackPanel>
                    </Border>
                    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{Binding OperationStatus}" Style="{StaticResource Text.Secondary}" AutomationProperties.AutomationId="Knowledge.Status" />
                        <WrapPanel Grid.Column="1"><Button Content="Включить / выключить" Command="{Binding ToggleSourceCommand}" AutomationProperties.AutomationId="Knowledge.ToggleSource" /><Button Content="Переиндексировать" Command="{Binding ReindexCommand}" AutomationProperties.AutomationId="Knowledge.Reindex" /><Button Content="Откатить" Command="{Binding RollbackCommand}" AutomationProperties.AutomationId="Knowledge.Rollback" /></WrapPanel>
                    </Grid>
                </StackPanel>
            </design:FeatureSection>

            <design:FeatureSection Style="{StaticResource Feature.Section}" Margin="0"
                                   Title="Правила доверия"
                                   Description="Источник и актуальность проверяются до формирования ответа.">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                               Text="Официальные статьи проходят source review и governance lint. Сведения сообщества всегда сопровождаются пометкой «По данным игроков:». Просроченный или конфликтный факт не используется для ответа." />
                    <Border Style="{StaticResource Surface.RaisedCard}" Margin="0,16,0,0">
                        <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding PipelineStatus}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </design:FeatureSection>
        </StackPanel>
    </ScrollViewer>
</UserControl>
