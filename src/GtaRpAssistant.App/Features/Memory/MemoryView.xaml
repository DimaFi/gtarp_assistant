<UserControl x:Class="GtaRpAssistant.App.Features.MemoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:design="clr-namespace:GtaRpAssistant.App.DesignSystem.Controls" AutomationProperties.AutomationId="Page.Memory">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="920" Margin="0,0,14,20">
  <design:FeaturePageHeader Style="{StaticResource Feature.PageHeader}" Title="Память ассистента" Description="Подтверждённые вами сведения и стиль общения. Отдельно от чатов и базы игровых знаний." />
  <design:FeatureSection Style="{StaticResource Feature.Section}" Title="Записи памяти" Description="Эти записи доступны только локальной AI-модели и никогда не считаются игровыми фактами.">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <ListBox ItemsSource="{Binding Memories}" SelectedItem="{Binding Selected}" MinHeight="230" AutomationProperties.AutomationId="Memory.List"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Category}" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding Content}" TextWrapping="Wrap"/><TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Style="{StaticResource Text.Secondary}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    <StackPanel Grid.Column="2"><TextBlock Text="Категория" Style="{StaticResource Text.Label}"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Label"/><TextBlock Text="Что ассистент должен помнить" Style="{StaticResource Text.Label}"/><TextBox Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="110" TextWrapping="Wrap" MaxLength="500" AutomationProperties.AutomationId="Memory.Editor"/><WrapPanel><Button Content="Сохранить" Command="{Binding SaveMemoryCommand}" Style="{StaticResource Button.Primary}"/><Button Content="Новая" Command="{Binding NewMemoryCommand}"/><Button Content="Удалить" Command="{Binding DeleteMemoryCommand}" Style="{StaticResource Button.Danger}"/></WrapPanel><Button Content="Очистить всю память" Command="{Binding ClearAllCommand}" Style="{StaticResource Button.Danger}" HorizontalAlignment="Left"/></StackPanel>
   </Grid>
  </design:FeatureSection>
  <design:FeatureSection Style="{StaticResource Feature.Section}" Title="Характер и персонализация" Description="Настройки меняют подачу, но не verified facts, числа, правила сервера или решение валидатора.">
   <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,12,8"><TextBlock Text="Подробность" Style="{StaticResource Text.Label}"/><ComboBox SelectedIndex="{Binding DetailLevel}"><ComboBoxItem Content="Кратко"/><ComboBoxItem Content="Сбалансированно"/><ComboBoxItem Content="Подробно"/></ComboBox></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,8"><TextBlock Text="Юмор" Style="{StaticResource Text.Label}"/><ComboBox SelectedIndex="{Binding HumorLevel}"><ComboBoxItem Content="Без шуток"/><ComboBoxItem Content="Иногда"/><ComboBoxItem Content="Чаще"/></ComboBox></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,0,12,8"><TextBlock Text="Инициативность" Style="{StaticResource Text.Label}"/><ComboBox SelectedIndex="{Binding InitiativeLevel}"><ComboBoxItem Content="Только ответ"/><ComboBoxItem Content="Уместные подсказки"/><ComboBoxItem Content="Предлагать следующие шаги"/></ComboBox></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,8"><TextBlock Text="Тон" Style="{StaticResource Text.Label}"/><ComboBox SelectedIndex="{Binding Tone}"><ComboBoxItem Content="Нейтральный"/><ComboBoxItem Content="Дружелюбный"/><ComboBoxItem Content="Серьёзный"/></ComboBox></StackPanel>
   </Grid>
   <CheckBox IsChecked="{Binding AdaptiveEnabled}" Content="Постепенно адаптировать стиль только по моим явным просьбам" AutomationProperties.AutomationId="Memory.AdaptiveEnabled"/>
   <TextBlock Margin="24,2,0,8" Text="Например: «отвечай короче», «объясняй подробнее», «без шуток». Текст реплики не сохраняется — только понятное объяснение изменения." TextWrapping="Wrap" Style="{StaticResource Text.Secondary}"/>
   <WrapPanel HorizontalAlignment="Right"><Button Content="Обновить" Command="{Binding RefreshCommand}"/><Button Content="Сбросить стиль" Command="{Binding ResetPersonalityCommand}" Style="{StaticResource Button.Danger}"/><Button Content="Сохранить стиль" Command="{Binding SavePersonalityCommand}" Style="{StaticResource Button.Primary}" AutomationProperties.AutomationId="Memory.SavePersonality"/></WrapPanel>
   <TextBlock Text="Журнал адаптации" Style="{StaticResource Text.Label}" Margin="0,10,0,4"/>
   <ItemsControl ItemsSource="{Binding PersonalityChanges}" AutomationProperties.AutomationId="Memory.PersonalityChanges"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,3"><TextBlock Text="{Binding Reason}" TextWrapping="Wrap"/><TextBlock Style="{StaticResource Text.Secondary}"><Run Text="{Binding Trait}"/><Run Text=" · "/><Run Text="{Binding OldValue}"/><Run Text=" → "/><Run Text="{Binding NewValue}"/><Run Text=" · "/><Run Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/></TextBlock></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Button Content="Очистить журнал" Command="{Binding ClearChangesCommand}" HorizontalAlignment="Left"/>
   </StackPanel>
  </design:FeatureSection>
 </StackPanel></ScrollViewer>
</UserControl>
