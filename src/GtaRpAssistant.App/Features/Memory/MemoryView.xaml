<UserControl x:Class="GtaRpAssistant.App.Features.MemoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:design="clr-namespace:GtaRpAssistant.App.DesignSystem.Controls" AutomationProperties.AutomationId="Page.Memory">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="920" Margin="0,0,14,20">
  <design:FeaturePageHeader Style="{StaticResource Feature.PageHeader}" Title="Память ассистента" Description="Подтверждённые вами сведения и стиль общения. Отдельно от чатов и базы игровых знаний." />
  <design:FeatureSection Style="{StaticResource Feature.Section}" Title="Характер и персонализация" Description="Настройки меняют подачу, но не verified facts, числа, правила сервера или решение валидатора.">
   <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Margin="0,0,10,10" Padding="12" Background="{DynamicResource Brush.SurfaceRaised}" CornerRadius="10"><StackPanel><TextBlock Text="Подробность ответов" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding DetailLabel}" Style="{StaticResource Text.Secondary}"/><Slider Margin="0,5,0,0" Minimum="0" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DetailLevel, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="Memory.DetailSlider"/><Grid><TextBlock Text="Кратко" Style="{StaticResource Text.Caption}"/><TextBlock HorizontalAlignment="Right" Text="Подробно" Style="{StaticResource Text.Caption}"/></Grid></StackPanel></Border>
    <Border Grid.Column="1" Margin="4,0,4,10" Padding="12" Background="{DynamicResource Brush.SurfaceRaised}" CornerRadius="10"><StackPanel><TextBlock Text="Юмор" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding HumorLabel}" Style="{StaticResource Text.Secondary}"/><Slider Margin="0,5,0,0" Minimum="0" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding HumorLevel, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="Memory.HumorSlider"/><Grid><TextBlock Text="Минимум" Style="{StaticResource Text.Caption}"/><TextBlock HorizontalAlignment="Right" Text="Больше" Style="{StaticResource Text.Caption}"/></Grid></StackPanel></Border>
    <Border Grid.Column="2" Margin="4,0,4,10" Padding="12" Background="{DynamicResource Brush.SurfaceRaised}" CornerRadius="10"><StackPanel><TextBlock Text="Инициативность" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding InitiativeLabel}" Style="{StaticResource Text.Secondary}"/><Slider Margin="0,5,0,0" Minimum="0" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding InitiativeLevel, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="Memory.InitiativeSlider"/><Grid><TextBlock Text="Только ответ" Style="{StaticResource Text.Caption}"/><TextBlock HorizontalAlignment="Right" Text="Шаги" Style="{StaticResource Text.Caption}"/></Grid></StackPanel></Border>
    <Border Grid.Column="3" Margin="4,0,0,10" Padding="12" Background="{DynamicResource Brush.SurfaceRaised}" CornerRadius="10"><StackPanel><TextBlock Text="Тон" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding ToneLabel}" Style="{StaticResource Text.Secondary}"/><Slider Margin="0,5,0,0" Minimum="0" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Tone, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="Memory.ToneSlider"/><Grid><TextBlock Text="Нейтральный" Style="{StaticResource Text.Caption}"/><TextBlock HorizontalAlignment="Right" Text="Деловой" Style="{StaticResource Text.Caption}"/></Grid></StackPanel></Border>
   </Grid>
   <CheckBox IsChecked="{Binding AdaptiveEnabled}" Content="Постепенно адаптировать стиль только по моим явным просьбам" AutomationProperties.AutomationId="Memory.AdaptiveEnabled"/>
   <TextBlock Margin="24,2,0,8" Text="Например: «отвечай короче», «объясняй подробнее», «без шуток». Текст реплики не сохраняется — только понятное объяснение изменения." TextWrapping="Wrap" Style="{StaticResource Text.Secondary}"/>
   <WrapPanel HorizontalAlignment="Right"><Button Content="Обновить" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="Memory.Refresh"/><Button Content="Сбросить стиль" Command="{Binding ResetPersonalityCommand}" Style="{StaticResource Button.Danger}" AutomationProperties.AutomationId="Memory.ResetPersonality"/><Button Content="Сохранить стиль" Command="{Binding SavePersonalityCommand}" Style="{StaticResource Button.Primary}" AutomationProperties.AutomationId="Memory.SavePersonality"/></WrapPanel>
   <TextBlock Text="Журнал адаптации" Style="{StaticResource Text.Label}" Margin="0,10,0,4"/>
   <ItemsControl ItemsSource="{Binding PersonalityChanges}" AutomationProperties.AutomationId="Memory.PersonalityChanges"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,3"><TextBlock Text="{Binding Reason}" TextWrapping="Wrap"/><TextBlock Style="{StaticResource Text.Secondary}"><Run Text="{Binding Trait}"/><Run Text=" · "/><Run Text="{Binding OldValue}"/><Run Text=" → "/><Run Text="{Binding NewValue}"/><Run Text=" · "/><Run Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/></TextBlock></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Button Content="Очистить журнал" Command="{Binding ClearChangesCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="Memory.ClearChanges"/>
   </StackPanel>
  </design:FeatureSection>
  <design:FeatureSection Style="{StaticResource Feature.Section}" Title="Кандидаты памяти" Description="Ассистент замечает только явно сказанные предпочтения. До подтверждения они находятся лишь в RAM, исчезают через 24 часа и не попадают в запросы модели.">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ListBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}" MinHeight="90" MaxHeight="180" AutomationProperties.AutomationId="Memory.Candidates"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Content}" TextWrapping="Wrap"/><TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Secondary}"/><TextBlock Text="{Binding ExpiresAt, StringFormat=До {0:dd.MM HH:mm}}" Style="{StaticResource Text.Caption}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    <StackPanel Grid.Column="1" Margin="12,0,0,0"><Button Content="Сохранить" Command="{Binding ApproveCandidateCommand}" AutomationProperties.AutomationId="Memory.CandidateApprove"/><Button Content="Не запоминать" Command="{Binding RejectCandidateCommand}" AutomationProperties.AutomationId="Memory.CandidateReject"/><Button Content="Очистить кандидаты" Command="{Binding ClearCandidatesCommand}" Style="{StaticResource Button.Danger}" AutomationProperties.AutomationId="Memory.CandidatesClear"/></StackPanel>
   </Grid>
  </design:FeatureSection>
  <design:FeatureSection Style="{StaticResource Feature.Section}" Title="Записи памяти" Description="Эти записи доступны только локальной AI-модели и никогда не считаются игровыми фактами.">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <ListBox ItemsSource="{Binding Memories}" SelectedItem="{Binding Selected}" MinHeight="150" MaxHeight="210" AutomationProperties.AutomationId="Memory.List"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Category}" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding Content}" TextWrapping="Wrap"/><TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Style="{StaticResource Text.Secondary}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    <StackPanel Grid.Column="2"><TextBlock Text="Категория" Style="{StaticResource Text.Label}"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Label" AutomationProperties.AutomationId="Memory.Category"/><TextBlock Text="Что ассистент должен помнить" Style="{StaticResource Text.Label}"/><TextBox Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="78" TextWrapping="Wrap" MaxLength="500" AutomationProperties.AutomationId="Memory.Editor"/><WrapPanel><Button Content="Сохранить" Command="{Binding SaveMemoryCommand}" Style="{StaticResource Button.Primary}" AutomationProperties.AutomationId="Memory.Save"/><Button Content="Новая" Command="{Binding NewMemoryCommand}" AutomationProperties.AutomationId="Memory.New"/><Button Content="Удалить" Command="{Binding DeleteMemoryCommand}" Style="{StaticResource Button.Danger}" AutomationProperties.AutomationId="Memory.Delete"/><Button Content="Очистить всё" Command="{Binding ClearAllCommand}" Style="{StaticResource Button.Danger}" AutomationProperties.AutomationId="Memory.ClearAll"/></WrapPanel></StackPanel>
   </Grid>
  </design:FeatureSection>
 </StackPanel></ScrollViewer>
</UserControl>
