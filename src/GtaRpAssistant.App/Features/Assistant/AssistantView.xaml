<UserControl x:Class="GtaRpAssistant.App.Features.AssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:design="clr-namespace:GtaRpAssistant.App.DesignSystem.Controls"
             AutomationProperties.AutomationId="Page.Assistant">
    <Grid MaxWidth="780" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="4,2,4,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="19" VerticalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#E76F24" Offset="0" />
                        <GradientStop Color="#D3A23D" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" FontWeight="Bold" Text="✦" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="GTA RP Assistant" />
                <TextBlock Style="{StaticResource Text.Caption}" Text="Скажите или напишите вопрос" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox Width="210" Margin="0,0,6,0" ItemsSource="{Binding Conversations}"
                          SelectedItem="{Binding SelectedConversation}" DisplayMemberPath="Title"
                          ToolTip="История чатов — хранится локально"
                          AutomationProperties.AutomationId="Assistant.ConversationHistory" />
                <Button Style="{StaticResource Button.Ghost}" Content="Удалить" Command="{Binding DeleteConversationCommand}"
                        ToolTip="Удалить выбранный чат" AutomationProperties.AutomationId="Assistant.DeleteConversation" />
                <Button Style="{StaticResource Button.Ghost}" Content="Повторить" Command="{Binding RetryQuestionCommand}"
                        AutomationProperties.AutomationId="Assistant.Retry" />
                <Button Style="{StaticResource Button.Ghost}" Content="Новый чат" Command="{Binding NewConversationCommand}"
                        AutomationProperties.AutomationId="Assistant.NewConversation" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Border x:Name="WelcomeCard" MaxWidth="560"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Surface.Card}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Conversation.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock HorizontalAlignment="Center" FontSize="28" Text="✦" Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold"
                               Text="Чем помочь в GTA5RP?" />
                    <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                               Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                               Text="Можно спросить о работе, достижении, клубе или продолжить предыдущий вопрос. Игровые данные проверяются по локальной базе." />
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Conversation}" VerticalAlignment="Bottom" AutomationProperties.AutomationId="Assistant.Conversation">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4,3" Padding="14,10" MaxWidth="680" CornerRadius="16">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Role}" Value="User">
                                                <Setter Property="Background" Value="{DynamicResource Brush.AccentMuted}" />
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                <Setter Property="Text" Value="Ассистент" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Role}" Value="User"><Setter Property="Text" Value="Вы" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                        <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" Width="28" Height="26" Padding="2" Margin="8,-5,-7,-3"
                                                Content="⧉" ToolTip="Копировать" Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="Копировать сообщение" />
                                    </Grid>
                                    <design:MarkdownTextBlock Margin="0,4,0,0" Markdown="{Binding Text}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Margin="4,8,4,6" AutomationProperties.AutomationId="Assistant.VoicePreview">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Surface.RaisedCard}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding IsVoicePreview}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Проверьте распознанный текст" />
                    <TextBlock Margin="0,3,12,0" Style="{StaticResource Text.Caption}" Text="{Binding VoicePreviewStatus}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Ghost}" Content="Отменить" Command="{Binding CancelVoicePreviewCommand}"
                            AutomationProperties.AutomationId="Assistant.CancelVoicePreview" />
                    <Button Style="{StaticResource Button.Primary}" Content="Отправить" Command="{Binding ConfirmVoicePreviewCommand}"
                            AutomationProperties.AutomationId="Assistant.ConfirmVoicePreview" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="4,6,4,0" Padding="12" CornerRadius="18"
                Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBox x:Name="QuestionBox" MinHeight="62" MaxHeight="130" Padding="4" BorderThickness="0" Background="Transparent"
                         FontSize="15" VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True"
                         TabIndex="20" AutomationProperties.AutomationId="Assistant.Question"
                         Text="{Binding TranscriptText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding ProcessQuestionCommand}" /></TextBox.InputBindings>
                </TextBox>
                <TextBlock Margin="5,5,5,0" VerticalAlignment="Top" IsHitTestVisible="False"
                           Foreground="{DynamicResource Brush.TextMuted}" FontSize="15"
                           Text="Напишите вопрос по GTA5RP…">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=QuestionBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Text, ElementName=QuestionBox}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ComboBox Width="124" Padding="8,5" TabIndex="10" SelectedIndex="{Binding SelectedSourceIndex}"
                              AutomationProperties.AutomationId="Assistant.Source">
                        <ComboBoxItem Content="Микрофон" /><ComboBoxItem Content="Звук игры" />
                    </ComboBox>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Ghost}" Content="Фото" TabIndex="25"
                                Command="{Binding AnalyzeImageCommand}" AutomationProperties.AutomationId="Assistant.AnalyzeImage"
                                ToolTip="Выбрать PNG или JPEG для локального Vision-анализа после preview" />
                        <Button Style="{StaticResource Button.Ghost}" Content="Контекст" TabIndex="30"
                                Command="{Binding AddContextCommand}" AutomationProperties.AutomationId="Assistant.AddContext" />
                        <Button Style="{StaticResource Button.Primary}" Content="Отправить" TabIndex="40"
                                Command="{Binding ProcessQuestionCommand}" AutomationProperties.AutomationId="Assistant.Ask" />
                        <Button Style="{StaticResource Button.Ghost}" TabIndex="50"
                                Command="{Binding StartVoiceCommand}" AutomationProperties.AutomationId="Assistant.Voice">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎙" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding VoiceButtonText}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="8,7,8,2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding PipelineStatus}" TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="Assistant.Status" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource Button.Ghost}" Padding="6,2" Content="Копировать" Command="{Binding CopyAnswerCommand}"
                        AutomationProperties.AutomationId="Assistant.CopyAnswer" />
                <Button Style="{StaticResource Button.Ghost}" Padding="6,2" Content="Отмена" Command="{Binding CancelRequestCommand}"
                        AutomationProperties.AutomationId="Assistant.Cancel" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
