<UserControl x:Class="GtaRpAssistant.App.Features.AudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="Page.Audio">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760" HorizontalAlignment="Stretch" Margin="0,0,14,20">
            <Border Style="{StaticResource Surface.Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Heading}" Text="Устройства" />
                    <TextBlock Margin="0,4,0,12" Style="{StaticResource Text.Secondary}" Text="Выберите микрофон и выход, с которого захватывается звук GTA." />
                    <TextBlock Style="{StaticResource Text.Label}" Text="Микрофон" />
                    <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}" DisplayMemberPath="DisplayName" IsEnabled="{Binding AudioSettingsEnabled}" AutomationProperties.AutomationId="Audio.Microphone" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Обновить устройства" Command="{Binding RefreshDevicesCommand}" AutomationProperties.AutomationId="Audio.RefreshDevices" />
                        <Button Content="Тест микрофона" Command="{Binding TestMicrophoneCommand}" AutomationProperties.AutomationId="Audio.TestMicrophone" />
                        <Button Style="{StaticResource Button.Primary}" Content="{Binding ListeningButtonText}" Command="{Binding ToggleListeningCommand}" AutomationProperties.AutomationId="Audio.ToggleListening" />
                    </StackPanel>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding MicrophoneLevel, Mode=OneWay}" AutomationProperties.AutomationId="Audio.MicrophoneLevel" />
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource Text.Caption}" Text="{Binding MicrophoneLevelText}" />
                    </Grid>
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Label}" Text="Устройство вывода для game audio" />
                    <ComboBox ItemsSource="{Binding RenderDevices}" SelectedItem="{Binding SelectedRenderDevice}" DisplayMemberPath="DisplayName" IsEnabled="{Binding AudioSettingsEnabled}" AutomationProperties.AutomationId="Audio.RenderDevice" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Surface.Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Heading}" Text="Локальное распознавание речи" />
                    <TextBlock Margin="0,4,0,12" Style="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap"
                               Text="Опциональный STT-пак работает без облака. Если он не установлен или не прошёл проверку, используется настроенный резервный provider." />
                    <CheckBox Content="Использовать автономный STT-пак при наличии" IsChecked="{Binding Settings.EmbeddedSttEnabled}"
                              IsEnabled="{Binding AudioSettingsEnabled}" AutomationProperties.AutomationId="Audio.EmbeddedSttEnabled" />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Label}" Text="Папка STT-пака (пусто — стандартная папка)" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Settings.EmbeddedSttPackPath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding AudioSettingsEnabled}"
                                 AutomationProperties.AutomationId="Audio.EmbeddedSttPackPath" />
                        <Button Grid.Column="1" Content="Выбрать…" Command="{Binding BrowseEmbeddedSttPackCommand}" IsEnabled="{Binding AudioSettingsEnabled}"
                                AutomationProperties.AutomationId="Audio.BrowseEmbeddedSttPack" />
                    </Grid>
                    <TextBlock Style="{StaticResource Text.Caption}" Text="Стандартно: %LOCALAPPDATA%\GtaRpAssistant\model-packs\stt" />
                    <Border Style="{StaticResource Surface.RaisedCard}" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SttStatus}" TextWrapping="Wrap" Style="{StaticResource Text.Secondary}" AutomationProperties.AutomationId="Audio.SttStatus" />
                            <Button Grid.Column="1" Margin="10,0,0,0" Content="Проверить" Command="{Binding CheckSttCommand}" AutomationProperties.AutomationId="Audio.CheckStt" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Surface.Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Heading}" Text="Захват и память" />
                    <TextBlock Margin="0,4,0,12" Style="{StaticResource Text.Secondary}" Text="Game audio не активирует помощника и используется только как временный контекст." />
                    <CheckBox Content="Включить game audio" IsChecked="{Binding Settings.EnableGameAudio}" IsEnabled="{Binding AudioSettingsEnabled}" />
                    <CheckBox Content="Предпочитать process-specific loopback" IsChecked="{Binding Settings.PreferProcessLoopback}" IsEnabled="{Binding AudioSettingsEnabled}" />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Label}" Text="Режим Ctrl+Alt+A" />
                    <ComboBox SelectedIndex="{Binding Settings.VoiceHotkeyMode}" IsEnabled="{Binding AudioSettingsEnabled}"
                              AutomationProperties.AutomationId="Audio.VoiceHotkeyMode">
                        <ComboBoxItem Content="Нажатие — включить или отменить" />
                        <ComboBoxItem Content="Удерживать, пока говорите" />
                    </ComboBox>
                    <CheckBox Content="Сразу отправлять распознанный голосовой вопрос" IsChecked="{Binding Settings.VoiceAutoSubmit}" IsEnabled="{Binding AudioSettingsEnabled}"
                              ToolTip="Если выключено, перед отправкой появится редактируемый preview." AutomationProperties.AutomationId="Audio.VoiceAutoSubmit" />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Label}" Text="Память transcript/audio" />
                    <ComboBox SelectedValue="{Binding Settings.TranscriptMinutes}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="30 секунд" Tag="0" />
                        <ComboBoxItem Content="1 минута" Tag="1" />
                        <ComboBoxItem Content="3 минуты" Tag="3" />
                        <ComboBoxItem Content="5 минут" Tag="5" />
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Button.Primary}" Content="Сохранить настройки" Command="{Binding SaveSettingsCommand}" Margin="0,6,0,6" AutomationProperties.AutomationId="Audio.Save" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
