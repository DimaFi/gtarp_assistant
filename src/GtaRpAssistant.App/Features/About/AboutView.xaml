<UserControl x:Class="GtaRpAssistant.App.Features.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="Page.About">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch" Margin="0,0,10,20">
            <Grid Margin="4,4,4,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Display}" FontSize="24" Text="О приложении" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}"
                               Text="Версия, среда и безопасная диагностика без ключей и истории диалога." />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" Content="Обновить"
                        Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="About.Refresh" />
            </Grid>

            <UniformGrid Columns="3" Margin="0,0,0,12">
                <Border Style="{StaticResource Surface.RaisedCard}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="ВЕРСИЯ" />
                        <TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Heading}" Text="{Binding Version}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Surface.RaisedCard}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="БАЗА ЗНАНИЙ" />
                        <TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Heading}" Text="{Binding KnowledgeCount}" />
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Caption}" Text="{Binding KnowledgeBreakdown}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Surface.RaisedCard}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="CLOUD" />
                        <TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Heading}" Text="{Binding Cloud}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Surface.Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Heading}" Text="Среда" />
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="ПЛАТФОРМА" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" Text="{Binding Platform}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource Text.Caption}" Text="RUNTIME" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding Runtime}" />
                        <TextBlock Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource Text.Caption}" Text="LOCAL AI" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding LocalAi}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Surface.Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Heading}" Text="Диагностика" />
                    <TextBlock Margin="0,4,0,10" Style="{StaticResource Text.Caption}"
                               Text="Можно скопировать вручную. API-ключи, transcript и содержимое запросов сюда не входят." />
                    <TextBox Text="{Binding DiagnosticSummary, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" MinHeight="132"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.AutomationId="About.Diagnostics" />
                    <TextBlock Margin="0,12,0,5" Style="{StaticResource Text.Caption}" Text="ПАПКА ДАННЫХ" />
                    <TextBox Text="{Binding DataDirectory, Mode=OneWay}" IsReadOnly="True"
                             AutomationProperties.AutomationId="About.DataDirectory" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
