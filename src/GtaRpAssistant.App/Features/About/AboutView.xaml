<UserControl x:Class="GtaRpAssistant.App.Features.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:design="clr-namespace:GtaRpAssistant.App.DesignSystem.Controls"
             AutomationProperties.AutomationId="Page.About">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="860" HorizontalAlignment="Stretch" Margin="0,0,10,20">
            <design:FeaturePageHeader Style="{StaticResource Feature.PageHeader}"
                                      Title="О приложении"
                                      Description="Версия, локальная среда и безопасная диагностика без ключей и истории диалога."
                                      ActionText="Обновить"
                                      ActionCommand="{Binding RefreshCommand}"
                                      ActionAutomationId="About.Refresh" />

            <UniformGrid Columns="3" Margin="0,0,0,12">
                <design:MetricCard Style="{StaticResource Feature.MetricCard}" Margin="0,0,6,0"
                                   Label="ВЕРСИЯ" Value="{Binding DisplayVersion}"
                                   AccentBrush="{DynamicResource Brush.Accent}" />
                <design:MetricCard Style="{StaticResource Feature.MetricCard}" Margin="6,0"
                                   Label="БАЗА ЗНАНИЙ" Value="{Binding KnowledgeCount}"
                                   Detail="{Binding KnowledgeBreakdown}"
                                   AccentBrush="{DynamicResource Brush.Success}" />
                <design:MetricCard Style="{StaticResource Feature.MetricCard}" Margin="6,0,0,0"
                                   Label="ОБЛАЧНЫЕ ЗАПРОСЫ" Value="{Binding Cloud}"
                                   AccentBrush="{DynamicResource Brush.TextMuted}" />
            </UniformGrid>

            <design:FeatureSection Style="{StaticResource Feature.Section}" Title="Среда"
                                   Description="Текущая платформа и выбранный локальный AI-маршрут.">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="118" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Text.Caption}" Text="ПЛАТФОРМА" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" Text="{Binding Platform}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource Text.Caption}" Text="RUNTIME" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding Runtime}" />
                    <TextBlock Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource Text.Caption}" Text="LOCAL AI" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding LocalAi}" TextWrapping="Wrap" />
                </Grid>
            </design:FeatureSection>

            <design:FeatureSection Style="{StaticResource Feature.Section}" Margin="0"
                                   Title="Диагностика"
                                   Description="Эти данные можно скопировать вручную. API-ключи, transcript и содержимое запросов сюда не входят.">
                <StackPanel>
                    <TextBox Text="{Binding DiagnosticSummary, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" MinHeight="132"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.AutomationId="About.Diagnostics" />
                    <TextBlock Margin="0,12,0,5" Style="{StaticResource Text.Caption}" Text="ПАПКА ДАННЫХ" />
                    <TextBox Text="{Binding DataDirectory, Mode=OneWay}" IsReadOnly="True"
                             AutomationProperties.AutomationId="About.DataDirectory" />
                </StackPanel>
            </design:FeatureSection>
        </StackPanel>
    </ScrollViewer>
</UserControl>
