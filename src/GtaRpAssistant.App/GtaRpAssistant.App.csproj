<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GtaRpAssistant.Core\GtaRpAssistant.Core.csproj" />
    <ProjectReference Include="..\GtaRpAssistant.Infrastructure.Windows\GtaRpAssistant.Infrastructure.Windows.csproj" />
    <ProjectReference Include="..\GtaRpAssistant.Knowledge\GtaRpAssistant.Knowledge.csproj" />
    <ProjectReference Include="..\GtaRpAssistant.LocalData\GtaRpAssistant.LocalData.csproj" />
    <ProjectReference Include="..\GtaRpAssistant.Providers\GtaRpAssistant.Providers.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\knowledge\packs\**\*">
      <Link>knowledge\packs\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\knowledge\reference\community\**\*">
      <Link>knowledge\reference\community\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
