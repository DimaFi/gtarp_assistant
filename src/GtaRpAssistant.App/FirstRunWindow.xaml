<Window x:Class="GtaRpAssistant.App.FirstRunWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Первый запуск" Width="650" Height="470" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.TextPrimary}">
 <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Быстрая настройка" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="ProgressText" Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextSecondary}"/></StackPanel>
  <Border Grid.Row="1" Margin="0,24" Padding="24" Style="{StaticResource Surface.RaisedCard}"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="StepIcon" FontSize="32"/><TextBlock x:Name="StepTitle" Margin="0,12,0,0" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="StepDescription" Margin="0,10,0,0" FontSize="14" TextWrapping="Wrap" LineHeight="22"/><TextBlock x:Name="StepHint" Margin="0,18,0,0" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"/></StackPanel></Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Пропустить всё — только база знаний" Click="SkipClick" Style="{StaticResource Button.Ghost}"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="BackButton" Content="Назад" Click="BackClick"/><Button x:Name="NextButton" Content="Далее" Click="NextClick" Style="{StaticResource Button.Primary}"/></StackPanel></Grid>
 </Grid>
</Window>
