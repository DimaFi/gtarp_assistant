<Window x:Class="GtaRpAssistant.App.FirstRunWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Первый запуск" Width="720" Height="560" MinWidth="520" MinHeight="430" SizeToContent="Manual" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.TextPrimary}">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Быстрая настройка" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="ProgressText" Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextSecondary}"/><ProgressBar x:Name="SetupProgress" Margin="0,14,0,0" Height="5" Minimum="0" Maximum="8" Value="1" IsHitTestVisible="False"/></StackPanel>
  <Border Grid.Row="1" Margin="0,20" Style="{StaticResource Surface.RaisedCard}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel VerticalAlignment="Center" Margin="4"><Border Width="58" Height="58" HorizontalAlignment="Left" Background="{DynamicResource Brush.AccentMuted}" CornerRadius="16"><TextBlock x:Name="StepIcon" FontSize="28" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="StepTitle" Margin="0,16,0,0" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="StepDescription" Margin="0,10,0,0" FontSize="14" TextWrapping="Wrap" LineHeight="22"/><TextBlock x:Name="StepHint" Margin="0,18,0,0" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" LineHeight="20"/></StackPanel></ScrollViewer></Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Пропустить всё — только база знаний" Click="SkipClick" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="BackButton" Content="Назад" Click="BackClick"/><Button x:Name="NextButton" Content="Далее" Click="NextClick" Style="{StaticResource Button.Primary}"/></StackPanel></Grid>
 </Grid>
</Window>
