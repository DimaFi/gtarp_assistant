<Window x:Class="GtaRpAssistant.App.VisionPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:design="clr-namespace:GtaRpAssistant.App.DesignSystem.Controls"
        Title="Подтверждение снимка"
        Width="920" Height="680" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="Segoe UI" ShowInTaskbar="False"
        AutomationProperties.AutomationId="Dialog.VisionPreview">
    <design:VisionConsentCard x:Name="ConsentCard" Margin="{StaticResource Space.Window}"
                              ConfirmRequested="ConsentCard_ConfirmRequested"
                              CancelRequested="ConsentCard_CancelRequested" />
</Window>
