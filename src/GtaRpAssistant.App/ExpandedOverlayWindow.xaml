<Window x:Class="GtaRpAssistant.App.ExpandedOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:design="clr-namespace:GtaRpAssistant.App.DesignSystem.Controls"
        Width="620" SizeToContent="Height" MaxHeight="760"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{DynamicResource Brush.TextPrimary}" FontFamily="Segoe UI"
        ShowInTaskbar="False" ShowActivated="True" Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        AutomationProperties.AutomationId="Overlay.Expanded">
    <design:OverlayCardShell x:Name="CardShell" Style="{StaticResource Surface.OverlayCardShell}" IsExpanded="True"
                             AutomationProperties.AutomationId="Overlay.ExpandedCardShell">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <WrapPanel>
                        <design:OverlayStatusPill x:Name="StatusPill" Margin="0,0,8,8"
                                                  Style="{StaticResource Status.OverlayPill}" />
                        <Border x:Name="CommunityBadge" Style="{StaticResource Badge.Community}"
                                Margin="0,0,8,8" AutomationProperties.AutomationId="Overlay.CommunityBadge">
                            <TextBlock Foreground="{DynamicResource Brush.AccentHover}" FontSize="11" FontWeight="SemiBold"
                                       Text="ДАННЫЕ ИГРОКОВ" />
                        </Border>
                    </WrapPanel>
                    <TextBlock x:Name="TitleText" Style="{StaticResource Text.Display}" FontSize="22"
                               AutomationProperties.AutomationId="Overlay.ExpandedTitle" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" Content="×" Click="Close_Click"
                        FontSize="16" Padding="10,5" Margin="12,0,0,0" VerticalAlignment="Top" ToolTip="Закрыть"
                        AutomationProperties.AutomationId="Overlay.Close" />
            </Grid>

            <ScrollViewer x:Name="AnswerScroll" Grid.Row="1" Margin="0,18,0,0" MaxHeight="460" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="SummaryText" Style="{StaticResource Text.Body}" FontSize="15" LineHeight="23"
                               TextWrapping="Wrap" AutomationProperties.AutomationId="Overlay.ExpandedMessage" />

                    <StackPanel x:Name="StepsSection" Margin="0,18,0,0">
                        <TextBlock Style="{StaticResource Text.Caption}" Text="ЧТО ДЕЛАТЬ" />
                        <ItemsControl x:Name="StepsList" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Brush.AccentMuted}">
                                            <TextBlock Text="•" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.AccentHover}" FontWeight="Bold" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Text.Secondary}"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="CausesSection" Margin="0,18,0,0">
                        <TextBlock Style="{StaticResource Text.Caption}" Text="ВОЗМОЖНЫЕ ПРИЧИНЫ" />
                        <ItemsControl x:Name="CausesList" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="•" Foreground="{DynamicResource Brush.TextSecondary}" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Text.Secondary}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="FollowUpsSection" Margin="0,18,0,0">
                        <TextBlock Style="{StaticResource Text.Caption}" Text="МОЖНО УТОЧНИТЬ" />
                        <ItemsControl x:Name="FollowUpsList" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,3" Padding="10,7" CornerRadius="8" Background="{DynamicResource Brush.Input}">
                                        <TextBlock Text="{Binding}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="AnswerSourcePanel" Grid.Row="2" Margin="0,18,0,0" Style="{StaticResource Surface.RaisedCard}" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="ИСТОЧНИК" />
                        <TextBlock x:Name="SourceText" Margin="0,4,0,0" Style="{StaticResource Text.Secondary}"
                                   AutomationProperties.AutomationId="Overlay.ExpandedSource" />
                        <TextBlock x:Name="ProviderText" Margin="0,4,0,0" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                    <TextBlock x:Name="UpdatedText" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource Text.Caption}" />
                </Grid>
            </Border>

            <design:QuickActionsBar x:Name="AnswerQuickActions" Grid.Row="3" Margin="0,14,0,-6"
                                    TechnicalDetailsRequested="QuickActions_TechnicalDetailsRequested"
                                    IncorrectRequested="QuickActions_IncorrectRequested"
                                    SnoozeRequested="QuickActions_SnoozeRequested"
                                    CollapseRequested="QuickActions_CollapseRequested" />

            <Border x:Name="VoicePreviewPanel" Grid.Row="1" Grid.RowSpan="3" Margin="0,18,0,0"
                    Style="{StaticResource Surface.RaisedCard}" Visibility="Collapsed"
                    AutomationProperties.AutomationId="Overlay.VoicePreview">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" Text="РАСПОЗНАННЫЙ ВОПРОС" />
                    <TextBox x:Name="VoicePreviewText" Margin="0,8,0,10" MinHeight="86" MaxHeight="220"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                             AutomationProperties.AutomationId="Overlay.VoicePreviewText" />
                    <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                               Text="Исправьте текст при необходимости. До подтверждения вопрос не отправляется." />
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Button.Danger}" Content="Отменить" Click="VoicePreviewCancel_Click"
                                AutomationProperties.AutomationId="Overlay.VoicePreviewCancel" />
                        <Button Style="{StaticResource Button.Primary}" Content="Отправить" Click="VoicePreviewConfirm_Click"
                                AutomationProperties.AutomationId="Overlay.VoicePreviewConfirm" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </design:OverlayCardShell>
</Window>
