<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:app="clr-namespace:GtaRpAssistant.App"
                    xmlns:design="clr-namespace:GtaRpAssistant.App.DesignSystem.Controls">
    <Style x:Key="Surface.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="{StaticResource Space.Card}" />
    </Style>
    <Style x:Key="Surface.RaisedCard" TargetType="Border" BasedOn="{StaticResource Surface.Card}">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    </Style>
    <Style x:Key="Surface.Navigation" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="8" />
    </Style>
    <Style x:Key="Surface.Overlay" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Overlay}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Overlay}" />
        <Setter Property="Padding" Value="18" />
    </Style>
    <Style x:Key="Surface.OverlayCardShell" TargetType="design:OverlayCardShell">
        <Setter Property="Background" Value="{DynamicResource Brush.Overlay}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Overlay}" />
        <Setter Property="Padding" Value="22,18,18,18" />
        <Setter Property="AccentBrush" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="design:OverlayCardShell">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="6" Opacity="0.36" />
                        </Border.Effect>
                        <Grid>
                            <Border Width="4" Margin="8,12,0,12"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding AccentBrush}"
                                    CornerRadius="2" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tone" Value="{x:Static app:OverlayTone.Success}">
                            <Setter Property="AccentBrush" Value="{DynamicResource Brush.Success}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="{x:Static app:OverlayTone.Warning}">
                            <Setter Property="AccentBrush" Value="{DynamicResource Brush.Warning}" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.OverlayExpanded}" />
                            <Setter Property="Padding" Value="26,22,22,22" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Badge.Source" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Input}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style x:Key="Badge.Community" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentMuted}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Padding" Value="9,5" />
    </Style>
    <Style x:Key="Status.Pill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.SuccessMuted}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,7" />
    </Style>
    <Style x:Key="Status.OverlayPill" TargetType="design:OverlayStatusPill">
        <Setter Property="AccentBrush" Value="{DynamicResource Brush.AccentHover}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="design:OverlayStatusPill">
                    <Border x:Name="Chrome" Padding="9,5" CornerRadius="8"
                            Background="{DynamicResource Brush.AccentMuted}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center"
                                     Fill="{TemplateBinding AccentBrush}" />
                            <TextBlock Text="{TemplateBinding Text}" Foreground="{TemplateBinding AccentBrush}"
                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="ActivityDots" Text=" ···" Foreground="{TemplateBinding AccentBrush}"
                                       FontSize="11" FontWeight="SemiBold" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tone" Value="{x:Static app:OverlayTone.Success}">
                            <Setter Property="AccentBrush" Value="{DynamicResource Brush.Success}" />
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.SuccessMuted}" />
                        </Trigger>
                        <Trigger Property="Tone" Value="{x:Static app:OverlayTone.Warning}">
                            <Setter Property="AccentBrush" Value="{DynamicResource Brush.Warning}" />
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.WarningMuted}" />
                        </Trigger>
                        <Trigger Property="Activity" Value="{x:Static app:OverlayActivity.Listening}">
                            <Setter TargetName="ActivityDots" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Activity" Value="{x:Static app:OverlayActivity.Thinking}">
                            <Setter TargetName="ActivityDots" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource Brush.BorderSubtle}" />
        <Setter Property="Margin" Value="0,14" />
    </Style>
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="Margin" Value="0,0,6,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                <Setter Property="Background" Value="{DynamicResource Brush.AccentMuted}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
