<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:design="clr-namespace:GtaRpAssistant.App.DesignSystem.Controls">
    <Style x:Key="Feature.PageHeader" TargetType="design:FeaturePageHeader">
        <Setter Property="Margin" Value="4,4,4,18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="design:FeaturePageHeader">
                    <Grid Margin="{TemplateBinding Margin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Display}" Text="{TemplateBinding Title}" />
                            <TextBlock x:Name="Description" Margin="0,4,0,0" MaxWidth="720"
                                       HorizontalAlignment="Left" Style="{StaticResource Text.Secondary}"
                                       Text="{TemplateBinding Description}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="Action" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top"
                                Style="{StaticResource Button.Ghost}" Content="{TemplateBinding ActionText}"
                                Command="{TemplateBinding ActionCommand}"
                                AutomationProperties.AutomationId="{TemplateBinding ActionAutomationId}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Description" Value=""><Setter TargetName="Description" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="ActionText" Value=""><Setter TargetName="Action" Property="Visibility" Value="Collapsed" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Feature.Section" TargetType="design:FeatureSection">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="design:FeatureSection">
                    <Border Style="{StaticResource Surface.Card}">
                        <StackPanel>
                            <TextBlock x:Name="Title" Style="{StaticResource Text.Heading}" Text="{TemplateBinding Title}" />
                            <TextBlock x:Name="Description" Margin="0,4,0,0" Style="{StaticResource Text.Secondary}"
                                       Text="{TemplateBinding Description}" TextWrapping="Wrap" />
                            <ContentPresenter Margin="0,14,0,0" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Title" Value=""><Setter TargetName="Title" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="Description" Value=""><Setter TargetName="Description" Property="Visibility" Value="Collapsed" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Feature.MetricCard" TargetType="design:MetricCard">
        <Setter Property="MinHeight" Value="96" />
        <Setter Property="AccentBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="design:MetricCard">
                    <Border Style="{StaticResource Surface.RaisedCard}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Background="{TemplateBinding AccentBrush}" CornerRadius="2" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{TemplateBinding Label}" />
                                <TextBlock Margin="0,5,0,0" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           Text="{TemplateBinding Value}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{TemplateBinding Value}" />
                                <TextBlock x:Name="Detail" Margin="0,3,0,0" Style="{StaticResource Text.Caption}"
                                           Text="{TemplateBinding Detail}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Detail" Value=""><Setter TargetName="Detail" Property="Visibility" Value="Collapsed" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
