<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Background">#0E1015</Color>
    <Color x:Key="Color.Surface">#171A21</Color>
    <Color x:Key="Color.SurfaceRaised">#1D212B</Color>
    <Color x:Key="Color.SurfaceHover">#252A36</Color>
    <Color x:Key="Color.Input">#12151C</Color>
    <Color x:Key="Color.Overlay">#E6171A22</Color>
    <Color x:Key="Color.OverlayExpanded">#FA171A22</Color>
    <Color x:Key="Color.Border">#343947</Color>
    <Color x:Key="Color.BorderSubtle">#252A34</Color>
    <Color x:Key="Color.Accent">#7C6CF2</Color>
    <Color x:Key="Color.AccentHover">#9083F7</Color>
    <Color x:Key="Color.AccentMuted">#337C6CF2</Color>
    <Color x:Key="Color.SuccessMuted">#2463D69A</Color>
    <Color x:Key="Color.WarningMuted">#26F2C66D</Color>
    <Color x:Key="Color.TextPrimary">#F4F5F7</Color>
    <Color x:Key="Color.TextSecondary">#A8AEBD</Color>
    <Color x:Key="Color.TextMuted">#777F91</Color>
    <Color x:Key="Color.Success">#63D69A</Color>
    <Color x:Key="Color.Warning">#F2C66D</Color>
    <Color x:Key="Color.Error">#F07C82</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.Input" Color="{StaticResource Color.Input}" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="{StaticResource Color.Overlay}" />
    <SolidColorBrush x:Key="Brush.OverlayExpanded" Color="{StaticResource Color.OverlayExpanded}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="{StaticResource Color.BorderSubtle}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentMuted" Color="{StaticResource Color.AccentMuted}" />
    <SolidColorBrush x:Key="Brush.SuccessMuted" Color="{StaticResource Color.SuccessMuted}" />
    <SolidColorBrush x:Key="Brush.WarningMuted" Color="{StaticResource Color.WarningMuted}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}" />

    <!-- Compatibility alias for code and older XAML. -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Color.Accent}" />
</ResourceDictionary>
