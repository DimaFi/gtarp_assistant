<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Background">#202225</Color><Color x:Key="Color.Surface">#292C30</Color><Color x:Key="Color.SurfaceRaised">#33373C</Color>
    <Color x:Key="Color.SurfaceHover">#3A3F45</Color><Color x:Key="Color.Input">#26292D</Color><Color x:Key="Color.Overlay">#F0202225</Color><Color x:Key="Color.OverlayExpanded">#FA202225</Color>
    <Color x:Key="Color.Border">#4A4F56</Color><Color x:Key="Color.BorderSubtle">#3C4147</Color><Color x:Key="Color.Accent">#EF444C</Color><Color x:Key="Color.AccentHover">#FF6269</Color><Color x:Key="Color.AccentMuted">#492C30</Color>
    <Color x:Key="Color.SuccessMuted">#243B32</Color><Color x:Key="Color.WarningMuted">#463C23</Color><Color x:Key="Color.TextPrimary">#F4F5F6</Color><Color x:Key="Color.TextSecondary">#C3C7CC</Color><Color x:Key="Color.TextMuted">#969CA4</Color>
    <Color x:Key="Color.Success">#4AD295</Color><Color x:Key="Color.Warning">#F0B84B</Color><Color x:Key="Color.Error">#FF6B70</Color><Color x:Key="Color.OnAccent">#FFFFFF</Color><Color x:Key="Color.Gold">#D7AD55</Color>
    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}"/><SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/><SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}"/>
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}"/><SolidColorBrush x:Key="Brush.Input" Color="{StaticResource Color.Input}"/><SolidColorBrush x:Key="Brush.Overlay" Color="{StaticResource Color.Overlay}"/><SolidColorBrush x:Key="Brush.OverlayExpanded" Color="{StaticResource Color.OverlayExpanded}"/>
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/><SolidColorBrush x:Key="Brush.BorderSubtle" Color="{StaticResource Color.BorderSubtle}"/><SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/><SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}"/><SolidColorBrush x:Key="Brush.AccentMuted" Color="{StaticResource Color.AccentMuted}"/>
    <SolidColorBrush x:Key="Brush.SuccessMuted" Color="{StaticResource Color.SuccessMuted}"/><SolidColorBrush x:Key="Brush.WarningMuted" Color="{StaticResource Color.WarningMuted}"/><SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}"/><SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/><SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}"/>
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/><SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/><SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}"/><SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}"/><SolidColorBrush x:Key="Brush.Gold" Color="{StaticResource Color.Gold}"/><SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Color.Accent}"/>
</ResourceDictionary>
