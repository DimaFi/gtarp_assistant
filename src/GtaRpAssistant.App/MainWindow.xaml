<Window x:Class="GtaRpAssistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GTA RP Assistant"
        Icon="Assets/app-icon.ico"
        Height="900" Width="1440" MinHeight="680" MinWidth="980"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="Segoe UI"
        AutomationProperties.AutomationId="Window.Main"
        AutomationProperties.Name="GTA RP Assistant"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded">
    <Grid x:Name="CaptureRoot" Background="{DynamicResource Brush.Background}">
    <Grid Margin="26,22,26,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid x:Name="HeaderRegion" Margin="0" Height="0" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Display}" FontSize="25" Text="GTA RP Assistant" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Caption}" Text="Локальный игровой AI-компаньон" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource Status.Pill}" VerticalAlignment="Center">
                <TextBlock Text="{Binding AppStatus}" Foreground="{DynamicResource Brush.Success}" FontSize="12" FontWeight="SemiBold"
                           AutomationProperties.AutomationId="Status.Application" />
            </Border>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border x:Name="NavigationRegion" Style="{StaticResource Surface.Navigation}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Margin="10,8,10,26">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="13" Background="White" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1">
                                <Image Source="Assets/app-icon.png" Width="34" Height="34" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,2,0,0">
                                <TextBlock FontSize="20" FontWeight="Bold" Text="GTA RP" />
                                <TextBlock FontSize="15" Foreground="{DynamicResource Brush.Accent}" Text="Assistant" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom" Margin="12,16,12,8">
                        <Separator />
                        <TextBlock Style="{StaticResource Text.Label}" Text="Горячие клавиши" />
                        <TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Caption}"
                                   Text="Q  Оверлей  ·  A  Голос&#x0a;S  Экран     ·  P  Пауза" LineHeight="20" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Navigation.Button}" Command="{Binding SelectCommand}"
                                        AutomationProperties.AutomationId="{Binding Id, StringFormat=Navigation.{0}}"
                                        AutomationProperties.Name="{Binding Title}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Text="{Binding Symbol}" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" FontWeight="SemiBold" Text="{Binding Title}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
            <ContentControl x:Name="FeatureHost" Grid.Column="2" Content="{Binding SelectedPage}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="Shell.FeatureHost" />
        </Grid>
        <Grid x:Name="FooterRegion" Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="Локальная обработка · cloud только с разрешения" />
            <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Content="Пауза · Ctrl+Alt+P"
                    Command="{Binding TogglePauseCommand}" AutomationProperties.AutomationId="Action.TogglePause" />
        </Grid>
    </Grid>
    </Grid>
</Window>
